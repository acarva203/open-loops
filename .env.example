# Google OAuth 2.0 Credentials (from Google Cloud Console > Credentials)
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=https://your-app.vercel.app/api/auth/callback

# Vercel Cron Secret (protects /api/cron from unauthorized public requests)
CRON_SECRET=your-secure-random-cron-secret-key

# Calendar Target (defaults to "Open Loops Focus")
GCAL_TARGET_CALENDAR="Open Loops Focus"

# Optional: Remote Database URL (Supabase or Neon free Postgres connection string)
DATABASE_URL=postgresql://user:password@ep-sample.us-east-2.aws.neon.tech/neondb
